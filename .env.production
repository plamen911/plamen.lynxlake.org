# Build-time public config, read by `astro build`. Both values are public (they end
# up in the page). Left empty in the repo and filled in at deploy, preferably as
# Cloudflare Pages build variables, which take precedence over this file.
# A production build fails while PUBLIC_TURNSTILE_SITE_KEY is empty, unless
# ALLOW_MISSING_TURNSTILE=1 is set (CI and tests set it).
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFudyrknZhcKKnqn
# Optional: Cloudflare Web Analytics token; the beacon is rendered only when set.
PUBLIC_CF_ANALYTICS_TOKEN=8f6f82542e714e01b3ed4d877615c4dd
