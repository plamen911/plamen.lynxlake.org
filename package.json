{
  "name": "plamen-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev dist",
    "test": "vitest run",
    "typecheck": "astro check && tsc --noEmit",
    "ci": "npm run typecheck && ALLOW_MISSING_TURNSTILE=1 npm run test && ALLOW_MISSING_TURNSTILE=1 npm run build && npm run check-public",
    "evals": "tsx scripts/chat-evals.ts",
    "evals:server": "bash scripts/evals-server.sh",
    "check-public": "tsx scripts/check-public.ts",
    "questions": "wrangler d1 execute plamen-site --remote --command \"SELECT ts, question FROM questions ORDER BY ts DESC LIMIT 100\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "ultrahtml": "^1.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
