---
import type { Profile } from '../data/types';
import ChatWidget from './ChatWidget.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { links } = profile;
// Where each starter question is answered on the page, for visitors without JS.
// Typed as the starter tuple, so adding or removing a starter fails the build here.
type AnchorFor<T extends readonly string[]> = { [K in keyof T]: `#${string}` };
const starterAnchors = ['#projects', '#contact', '#stack'] satisfies AnchorFor<Profile['starterQuestions']>;
const starters = profile.starterQuestions.map((question, i) => ({ question, href: starterAnchors[i] }));
// On phones the CV button reads just "CV" so all four links fit one row;
// the full label stays the accessible name everywhere.
const cvShort = 'CV';
const cvLead = links.cv.label.endsWith(cvShort) ? links.cv.label.slice(0, -cvShort.length) : '';
---
<header class="hero">
  <nav class="wrap topnav" aria-label="Sections">
    <ul>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#ai-workflow">AI workflow</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a href="#stack">Stack</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <div class="wrap hero-grid">
    <div class="intro">
      <h1>{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <p class="badge"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
      <p class="summary">{profile.summary}</p>
      <ul class="actions">
        <li><a class="btn primary" data-click="cv" href={links.cv.href} target="_blank" rel="noopener" aria-label={links.cv.label}>{cvLead ? <><span class="cv-lead">{cvLead}</span>{cvShort}</> : links.cv.label}</a></li>
        <li><a class="btn" data-click="email" href={`mailto:${profile.email}`} target="_blank" rel="noopener">Email</a></li>
        <li><a class="btn" data-click="linkedin" href={links.linkedin.href} target="_blank" rel="noopener noreferrer">{links.linkedin.label}</a></li>
        <li><a class="btn" data-click="github" href={links.github.href} target="_blank" rel="noopener noreferrer">{links.github.label}</a></li>
      </ul>
    </div>

    <aside class="panel" aria-label="Questions about his work">
      <ChatWidget starters={profile.starterQuestions} email={profile.email}>
        <p class="panel-title">Questions about Plamen's work</p>
        <ul class="starters">
          {starters.map(({ question, href }) => (
            <li><a href={href}>{question}</a></li>
          ))}
        </ul>
        <p class="fallback">
          Anything else? Email <a data-click="email" href={`mailto:${profile.email}`} target="_blank" rel="noopener">{profile.email}</a>.
        </p>
      </ChatWidget>
    </aside>
  </div>
</header>

<style>
  .hero {
    --accent: var(--hero-accent);
    background: var(--hero-bg);
    color: var(--hero-text);
    padding-bottom: clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  /* One line at every width: the list's default inline padding is reset,
     items never break mid-label, and phones spread them edge to edge.
     The gap is only a minimum – space-between spreads the items. On the
     narrowest phones the type steps down; scrolling is a last resort. */
  .topnav ul {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 1.5rem 0;
    font-size: var(--step--1);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .topnav ul::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 374px) {
    .topnav ul {
      font-size: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .topnav ul {
      justify-content: flex-end;
      gap: 1.5rem;
    }
  }

  .topnav a {
    color: var(--hero-muted);
    text-decoration: none;
  }

  .topnav a:hover {
    color: var(--hero-text);
  }

  /* minmax(0, 1fr): without it the single phone column grows to its
     widest content and pushes text past the right margin. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    padding-top: clamp(2rem, 1rem + 5vw, 6rem);
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .tagline {
    margin-top: 1.25rem;
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--hero-accent);
    max-width: 24ch;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.75rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--badge-bg);
    color: var(--badge-text);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  .summary {
    margin-top: 1.75rem;
    color: var(--hero-muted);
    max-width: 60ch;
  }

  /* One row of buttons on phones: "Download CV" shortens to "CV" and the
     buttons share the width. Keyed to the intro column's width, not the
     screen, so the narrow tablet column gets the short label too. */
  .intro {
    container-type: inline-size;
  }

  .actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .actions li {
    flex: 1 1 auto;
  }

  .actions .btn {
    display: block;
    padding-inline: 0.5rem;
    text-align: center;
    white-space: nowrap;
  }

  .cv-lead {
    display: none;
  }

  @container (min-width: 440px) {
    .actions {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .actions li {
      flex: none;
    }

    .actions .btn {
      display: inline-block;
      padding-inline: 1.15rem;
    }

    .cv-lead {
      display: inline;
    }
  }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--hero-line);
    border-radius: 6px;
    color: var(--hero-text);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--step--1);
  }

  .btn:hover {
    border-color: var(--hero-muted);
  }

  .btn.primary {
    background: var(--hero-text);
    border-color: var(--hero-text);
    color: var(--hero-bg);
  }

  .btn.primary:hover {
    background: #ffffff;
  }

  .panel {
    background: var(--hero-panel);
    border: 1px solid var(--hero-line);
    border-radius: 12px;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .panel-title {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .starters {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .starters a {
    display: block;
    padding: 0.7rem 1rem;
    border: 1px solid var(--hero-line);
    border-radius: 8px 8px 8px 2px;
    color: var(--hero-text);
    text-decoration: none;
  }

  .starters a:hover {
    border-color: var(--hero-accent);
  }

  .fallback {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hero-line);
    color: var(--hero-muted);
    font-size: var(--step--1);
  }
</style>
