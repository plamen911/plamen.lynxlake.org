---
interface Props {
  starters: readonly string[];
  /** Contact email for the chat's notice and fallback (profile.email). */
  email: string;
}

const { starters, email } = Astro.props;
---
<div id="chat-root" data-starters={JSON.stringify(starters)} data-email={email}>
  <slot />
</div>

<script>
  import { mountChat } from '../chat/client/chat';

  // Without JS, or if mounting fails, the static fallback in #chat-root stays.
  const root = document.getElementById('chat-root');
  if (root) {
    try {
      mountChat(root, { endpoint: '/api/chat', siteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '' });
    } catch (error) {
      console.error('chat failed to start', error);
    }
  }
</script>

<style is:global>
  /* The chat's DOM is built by script, so these rules are global, scoped by #chat-root. */
  #chat-root .chat-title {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 700;
  }

  #chat-root .chat-log {
    display: grid;
    gap: 0.75rem;
    max-height: min(26rem, 55vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 1.25rem;
  }

  #chat-root .chat-log:empty {
    margin-top: 0;
  }

  #chat-root .chat-msg {
    padding: 0.7rem 1rem;
    border-radius: 8px;
    white-space: pre-wrap;
    max-width: 92%;
  }

  #chat-root .chat-msg.user {
    justify-self: end;
    background: var(--hero-line);
    border-radius: 8px 8px 2px 8px;
  }

  #chat-root .chat-msg.assistant {
    justify-self: start;
    border: 1px solid var(--hero-line);
    border-radius: 8px 8px 8px 2px;
  }

  #chat-root .chat-msg.is-error {
    color: var(--hero-muted);
  }

  #chat-root .chat-msg a {
    color: var(--hero-accent);
  }

  #chat-root .chat-msg.is-pending::after {
    content: '…';
    display: inline-block;
    color: var(--hero-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    #chat-root .chat-msg.is-pending::after {
      animation: chat-pulse 1.2s ease-in-out infinite;
    }
  }

  @keyframes chat-pulse {
    50% {
      opacity: 0.3;
    }
  }

  #chat-root .chat-offer {
    justify-self: start;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--hero-accent);
    border-radius: 6px;
    background: transparent;
    color: var(--hero-accent);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  #chat-root .chat-offer:hover {
    background: var(--hero-line);
  }

  #chat-root .chat-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--hero-muted);
    font-size: var(--step--1);
  }

  #chat-root .chat-rate {
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--hero-line);
    border-radius: 6px;
    background: transparent;
    color: var(--hero-text);
    font: inherit;
    cursor: pointer;
  }

  #chat-root .chat-rate:hover {
    border-color: var(--hero-accent);
  }

  #chat-root .chat-starters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  #chat-root .chat-starter {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--hero-line);
    border-radius: 8px 8px 8px 2px;
    background: transparent;
    color: var(--hero-text);
    font: inherit;
    font-size: var(--step--1);
    text-align: left;
    cursor: pointer;
  }

  #chat-root .chat-starter:hover:not(:disabled) {
    border-color: var(--hero-accent);
  }

  #chat-root .chat-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  #chat-root .chat-input {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--hero-line);
    border-radius: 6px;
    background: var(--hero-bg);
    color: var(--hero-text);
    font: inherit;
  }

  #chat-root .chat-input::placeholder {
    color: var(--hero-muted);
    opacity: 1;
  }

  #chat-root .chat-send {
    flex: none;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--hero-text);
    border-radius: 6px;
    background: var(--hero-text);
    color: var(--hero-bg);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  /* The question form's Send is a square arrow button, so the input
     keeps nearly the whole row at every width. */
  #chat-root .chat-send-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    min-height: 3rem;
    padding: 0;
  }

  #chat-root .chat-send-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #chat-root .chat-send:hover:not(:disabled) {
    background: #ffffff;
  }

  #chat-root button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  #chat-root .chat-contact-toggle {
    display: block;
    margin-top: 0.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--hero-accent);
    font: inherit;
    font-size: var(--step--1);
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  #chat-root .chat-contact-toggle:hover {
    text-decoration-thickness: 2px;
  }

  /* "Leave your email" dialog: shown with showModal(), so it sits in the top layer. */
  #chat-root .chat-contact-dialog {
    box-sizing: border-box;
    width: calc(100% - 2rem);
    max-width: 440px;
    max-height: calc(100% - 2rem);
    margin: auto;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--hero-line);
    border-radius: 12px;
    background: var(--hero-panel);
    color: var(--hero-text);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.45);
  }

  #chat-root .chat-contact-dialog::backdrop {
    background: rgb(4 9 18 / 0.72);
  }

  #chat-root .chat-contact-box {
    position: relative;
    padding: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
  }

  #chat-root .chat-contact-x {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--hero-muted);
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  #chat-root .chat-contact-x:hover {
    background: var(--hero-line);
    color: var(--hero-text);
  }

  #chat-root .chat-contact-title {
    padding-right: 2.5rem;
    font-size: var(--step-1);
  }

  #chat-root .chat-contact-intro {
    margin-top: 0.5rem;
    color: var(--hero-muted);
    font-size: var(--step--1);
  }

  #chat-root .chat-contact:not([hidden]) {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  #chat-root .chat-contact-field {
    display: grid;
    gap: 0.3rem;
  }

  #chat-root .chat-contact-field label {
    font-size: var(--step--1);
    color: var(--hero-muted);
  }

  #chat-root .chat-contact textarea {
    resize: vertical;
  }

  #chat-root .chat-contact-note:empty {
    display: none;
  }

  #chat-root .chat-contact-note {
    font-size: var(--step--1);
  }

  #chat-root .chat-contact-note:focus {
    outline: none;
  }

  #chat-root .chat-contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  #chat-root .chat-contact-cancel {
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--hero-line);
    border-radius: 6px;
    background: transparent;
    color: var(--hero-text);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  #chat-root .chat-contact-cancel:hover {
    border-color: var(--hero-muted);
  }

  #chat-root .chat-contact-done:not([hidden]) {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 1.25rem;
  }

  #chat-root .chat-contact-status:not(:empty) {
    margin-top: 0.75rem;
    font-size: var(--step--1);
  }

  #chat-root .chat-contact-note a,
  #chat-root .chat-contact-status a {
    color: var(--hero-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    #chat-root .chat-contact-dialog[open] {
      animation: chat-contact-in 180ms ease-out;
    }

    #chat-root .chat-contact-dialog[open]::backdrop {
      animation: chat-contact-fade 180ms ease-out;
    }
  }

  @keyframes chat-contact-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.98);
    }
  }

  @keyframes chat-contact-fade {
    from {
      opacity: 0;
    }
  }

  #chat-root .chat-turnstile:not(:empty) {
    margin-top: 0.75rem;
  }

  #chat-root .chat-notice {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hero-line);
    color: var(--hero-muted);
    font-size: var(--step--1);
  }
</style>
