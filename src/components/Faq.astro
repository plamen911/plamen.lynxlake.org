---
import type { FaqItem } from '../data/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---
<section id="faq" class="section wrap" aria-labelledby="faq-title">
  <h2 id="faq-title" class="section-title">Questions people ask</h2>
  <dl class="faq">
    {
      items.map((item) => (
        <div class="item">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .faq {
    display: grid;
    gap: 2rem 3.5rem;
    margin: 0;
  }

  @media (min-width: 768px) {
    .faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  dt {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
  }

  dd {
    margin: 0.6rem 0 0;
    max-width: 60ch;
  }
</style>
