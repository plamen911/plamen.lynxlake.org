---
import type { StackGroup } from '../data/types';

interface Props {
  groups: StackGroup[];
}

const { groups } = Astro.props;
---
<section id="stack" class="section wrap" aria-labelledby="stack-title">
  <h2 id="stack-title" class="section-title">The tools he works with</h2>
  <div class="groups">
    {groups.map((group) => (
      <div class="group">
        <h3>{group.name}</h3>
        <ul>
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 2.5rem 2rem;
  }

  @media (min-width: 1100px) {
    .groups {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .group {
    border-top: 2px solid var(--text);
    padding-top: 1rem;
  }

  h3 {
    font-size: var(--step-1);
  }

  ul {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
  }
</style>
