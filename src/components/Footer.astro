---
interface Props {
  name: string;
  tagline: string;
}

const { name, tagline } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap inner">
    <p>© {year} {name}</p>
    <p>{tagline}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2rem;
  }
</style>
