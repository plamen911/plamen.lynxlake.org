---
interface Props {
  points: string[];
}

const { points } = Astro.props;
---
<section id="ai-workflow" class="section" aria-labelledby="ai-workflow-title">
  <div class="band">
    <div class="wrap">
      <h2 id="ai-workflow-title" class="section-title">How he works with AI on a codebase</h2>
      <ul class="points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--surface);
    border-block: 1px solid var(--line);
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .points {
    display: grid;
    gap: 2rem 3.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .points li {
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 44ch;
  }
</style>
